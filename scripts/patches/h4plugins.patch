+bool h4pWiFiScanStart(){
+    if (wf_scanning) return true;                       // already running
+    if (WiFi.getMode() == WIFI_OFF) return false;
+    // H4HARDEN:scan_floor_two_costs The floor has to cover BOTH things a scan
+    // spends, and testing only the largest block covered neither properly.
+    //
+    // A scan costs memory twice, at different moments:
+    //   ~700 bytes  bringing the station interface up, spent as the scan starts
+    //   ~880 bytes  ONE CONTIGUOUS block for the bss_info array in _scanDone,
+    //               spent seconds later, in an SDK callback we cannot guard
+    //
+    // The second one is measured, not estimated: the panic was
+    // "last failed alloc call: 4022A1FD(880)", decoded to
+    // ESP8266WiFiScanClass::_scanDone, at heap 2864 - four networks on a single
+    // channel, so this is a normal scan and not a worst case.
+    //
+    // The old floor was 600 on the block alone. I had walked it 2000 -> 1200 ->
+    // 600 chasing "the scan never runs", and overshot: 600 is below what a scan
+    // demonstrably needs, and free heap was never checked at all, so a scan could
+    // start with barely enough to bring STA up and then die in _scanDone.
+    //
+    // Refuse unless both costs fit, with the STA cost counted against the heap it
+    // will be taken from.
+    uint32_t biggest = wf_biggest_block();
+    uint32_t freeh   = ESP.getFreeHeap();
+    // START floors, not PASS floors - this test happens before enableSTA(true),
+    // so it must price that in too. See H4P_SCAN_START_HEAP_FLOOR.
+    if (biggest < H4P_SCAN_START_BLOCK_FLOOR || freeh < H4P_SCAN_START_HEAP_FLOOR) {
+        // _H4P_PRINTF, not H4P_PRINTF: the latter compiles to nothing unless
+        // H4P_DEBUG is set, which would make this refusal silent.
+        // Name the one that actually failed. The previous message printed both
+        // comparisons unconditionally - "SCAN REFUSED: heap 4376<3200 or block
+        // 1168<1200" - where the first half is plainly false and only the second
+        // is the reason. That cost a whole test round to see through.
+        _H4P_PRINTF("SCAN REFUSED: %s (heap %u/%u, block %u/%u)\n",
+                    freeh < H4P_SCAN_START_HEAP_FLOOR ? "free heap too low" : "no big enough block",
+                    (unsigned)freeh, (unsigned)H4P_SCAN_START_HEAP_FLOOR,
+                    (unsigned)biggest, (unsigned)H4P_SCAN_START_BLOCK_FLOOR);
+        return false;
+    }
+    wf_scan_begin();
+    return wf_scanning;
+}

+// H4HARDEN:scan_mode_restore_can_fail Putting the radio back is not guaranteed,
+// and failing silently is a trap the device never gets out of.
+//
+// WiFi.mode(WIFI_AP) ends up in wifi_set_opmode(), which has to tear down the
+// station netif - and that needs heap. When a sweep has just spent the heap,
+// the restore is exactly the call most likely to fail, and its return value was
+// being discarded. Measured over one capture: 43 consecutive heartbeats reading
+// AP_STA to the end of the run, with free heap pinned at 2272 and the largest
+// block at 1104, every accept refused. The station the restore failed to remove
+// is what holds the heap down, which is what makes the next restore fail too.
+//
+// Report it, and let the caller retry from somewhere with more headroom
+// (h4pWiFiScanRestoreAP(), called from the app's heartbeat).
+bool h4pWiFiScanRestoreAP() {
+    if (WiFi.getMode() != WIFI_AP_STA) return true;
+    if (wf_scanning || scanner) return false;       // a sweep still needs it
+    if (WiFi.mode(WIFI_AP)) return true;
+    _H4P_PRINTF("SCAN MODE RESTORE FAILED: still AP_STA, heap=%u block=%u\n",
+                (unsigned)ESP.getFreeHeap(), (unsigned)wf_biggest_block());
+    return false;
+}

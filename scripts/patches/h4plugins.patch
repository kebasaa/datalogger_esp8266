+// Largest single allocation the heap could still satisfy. The SDK needs one
+// contiguous block for its results, so total free heap is the wrong number.
+static uint32_t wf_biggest_block(){
+#if defined(ARDUINO_ARCH_ESP8266)
+    return ESP.getMaxFreeBlockSize();
+#elif defined(ARDUINO_ARCH_ESP32)
+    return ESP.getMaxAllocHeap();
+#else
+    return ESP.getFreeHeap();
+#endif
+}

+// Give up on a sweep and leave the radio exactly as we found it. Anything that
+// bails out after scanNetworks() has flipped the interface MUST come through
+// here, or the device keeps an idle station for the rest of the session.
+static void wf_scan_abort(const char* why) {
+    if (scanner) { h4.cancel(scanner); scanner = nullptr; }
+    wf_scanning = false;
+    wf_scan_channel = 0;
+    WiFi.scanDelete();
+    // H4HARDEN:abort_frees_before_it_restores Order matters more than the floor.
+    //
+    // Every wedge this session came from the same place: the abort path calls
+    // WiFi.mode(WIFI_AP) to put the radio back, that needs heap to tear the
+    // station interface down, and it is reached precisely when the heap is gone
+    // - so it fails, and the station it failed to remove is what keeps the heap
+    // too low to ever try again. The heartbeat's retry could not break it either
+    // (it needs memory too), so the device sat at heap=1768 block=576 refusing
+    // 27 accepts in a row until the client disconnected.
+    //
+    // Idle connections are the only memory this code owns outright, ~1.5 KB
+    // apiece, and by this point they are worthless: the sweep failed, and the
+    // radio has already left the AP's channel, so anything still open is dead
+    // regardless. Release them FIRST, then restore - which is the difference
+    // between a restore that can work and one that cannot.
+    //
+    // The scratch list goes back too, for the same reason: it is holding memory
+    // the restore may need, and the sweep that filled it is over.
+    std::vector<std::string>().swap(wf_pending);
+    auto conns = H4AsyncClient::openConnections;   // copy: close() mutates it
+    for(auto c : conns) if(c) c->close();
+    h4pWiFiScanRestoreAP();
+    _H4P_PRINTF("SCAN ABORTED: %s (released %u connection(s), heap=%u block=%u)\n",
+                why, (unsigned)conns.size(),
+                (unsigned)ESP.getFreeHeap(), (unsigned)wf_biggest_block());
+}
+
+static void wf_scan_finish() {
+    if (scanner) { h4.cancel(scanner); scanner = nullptr; }
+    wf_scanning = false;
+    wf_scan_channel = 0;
+    // Leave the radio as we found it. Every scanNetworks() call flips the
+    // interface to WIFI_AP_STA via enableSTA(true) and nothing put it back, so
+    // the device carried an idle station for the rest of the session. This can
+    // fail at low heap - see h4pWiFiScanRestoreAP() - and the app's heartbeat
+    // retries it from a quieter moment.
+    h4pWiFiScanRestoreAP();
+    // H4HARDEN:scan_release_scratch Hand back what the sweep was using.
+    //
+    // wf_pending is scratch - "wf_ssids = wf_pending" above is a COPY, so once
+    // the results are published every SSID is held twice, and wf_pending kept
+    // its array until the NEXT scan began (and even then only clear(), which
+    // frees no capacity at all). The scan is the moment the device is most
+    // short of memory, and this is the moment right after it.
+    //
+    // Swapping against a temporary releases the array; shrinking wf_ssids drops
+    // the slack left by however many passes found more than the final list.
+    std::vector<std::string>().swap(wf_pending);
+    wf_ssids.shrink_to_fit();
+    _H4P_PRINTF("SCAN COMPLETE: %u network(s), heap=%u block=%u\n",
+                (unsigned)wf_ssids.size(),
+                (unsigned)ESP.getFreeHeap(), (unsigned)wf_biggest_block());
+}

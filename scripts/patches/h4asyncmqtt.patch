 std::string mqttTraits::_decodestring(uint8_t** p){
+    // H4HARDEN:mqtt_decodestring_bounds the 2-byte length prefix comes off the wire
+    // and was trusted; a crafted value could read past the packet buffer. Clamp the
+    // read to [data, data+len) so malformed packets degrade to a short/empty string
+    // (handled by the existing empty-topic / protocol-error paths) instead of over-reading.
+    if(p && *p && data){
+        uint8_t* end = data + len;
+        if(*p + 2 > end){ *p = end; return ""; }
+        uint16_t tlen = _peek16(*p);
+        uint8_t* s = *p + 2;
+        if(s + tlen > end) tlen = (uint16_t)(end - s);
+        std::string rv((const char*) s, tlen);
+        *p = s + tlen;
+        return rv;
+    }
     return H4AMC_Helpers::decodestring(p);
 }
 

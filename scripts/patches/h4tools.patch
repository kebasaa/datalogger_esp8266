-	while(rv.size() && (rv.front()==d)) rv=std::string(++rv.begin(),rv.end());
-	return rv;	
+	// H4HARDEN:ltrim_no_rebuild Find the first kept character, then copy once.
+	//
+	// This used to be "while(front()==d) rv=std::string(++rv.begin(),rv.end());"
+	// - a complete reconstruction of the string per leading character stripped,
+	// each one allocating a new buffer while the old is still live. trim() calls
+	// rtrim then ltrim, so a value arriving with leading spaces cost one copy per
+	// space on a device with single-digit KB of heap.
+	size_t i=0;
+	while(i<s.size() && s[i]==d) i++;
